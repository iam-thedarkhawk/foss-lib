// FOSSLib Database Schema
// Uses SQLite for zero-config local development and portability

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  icon        String?
  description String?
  createdAt   DateTime         @default(now())
  apps        ProprietaryApp[]
}

model ProprietaryApp {
  id           String           @id @default(cuid())
  name         String
  description  String
  website      String?
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  alternatives AppAlternative[]
  createdAt    DateTime         @default(now())
}

model FossAlternative {
  id          String           @id @default(cuid())
  name        String
  description String
  license     String
  platforms   String // Comma-separated: "WINDOWS,MACOS,LINUX,WEB"
  repoUrl     String
  website     String?
  stars       Int?             @default(0)
  apps        AppAlternative[]
  createdAt   DateTime         @default(now())
}

model AppAlternative {
  id            String          @id @default(cuid())
  app           ProprietaryApp  @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId         String
  alternative   FossAlternative @relation(fields: [alternativeId], references: [id], onDelete: Cascade)
  alternativeId String
  fitNotes      String?

  @@unique([appId, alternativeId])
}

model Submission {
  id                 String   @id @default(cuid())
  proprietaryName    String
  alternativeName    String
  alternativeRepoUrl String
  alternativeWebsite String?
  categoryGuess      String?
  description        String
  submitterEmail     String?
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt          DateTime @default(now())
}
