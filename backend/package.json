{
  "name": "fosslib-backend",
  "version": "1.0.0",
  "description": "Backend API for FOSSLib catalogue",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node prisma/auto-provider.mjs && prisma generate && tsc",
    "start": "node dist/index.js",
    "db:sqlite": "node prisma/switch-db.mjs sqlite",
    "db:postgres": "node prisma/switch-db.mjs postgresql",
    "prisma:generate": "node prisma/auto-provider.mjs && prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "node prisma/auto-provider.mjs && prisma db push",
    "prisma:seed": "node prisma/auto-provider.mjs && tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
